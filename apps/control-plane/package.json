{
  "name": "@afra/control-plane",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run build -w @afra/shared && npm run build -w @afra/web",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply afra-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply afra-db --remote",
    "db:migrate:staging": "wrangler d1 migrations apply afra-db-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply afra-db-production --remote --env production"
  },
  "dependencies": {
    "@afra/shared": "*",
    "hono": "^4.13.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260816.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
