# ============================================================
# Afra Panel — نمونه متغیرهای محیطی
# این فایل را به .env کپی کنید و مقادیر واقعی را وارد نمایید.
# هرگز فایل .env واقعی را در Git کامیت نکنید.
# ============================================================

# --- کلید اصلی رمزنگاری (اجباری) ---
# برای تولید:  openssl rand -base64 48
# این کلید برای رمزنگاری اسرار در دیتابیس (AES-256-GCM) استفاده می‌شود.
AFRA_SECRET_KEY=

# --- محیط اجرا: development | staging | production ---
AFRA_ENV=development

# --- آدرس عمومی پنل (برای CORS و ساخت لینک‌ها) ---
AFRA_PANEL_URL=http://localhost:5173

# --- آدرس عمومی Worker لبه (تحویل اشتراک + endpoint پروکسی) ---
AFRA_EDGE_URL=http://localhost:8788

# ============================================================
# Cloudflare — اسرار سمت سرور. هرگز در فرانت‌اند استفاده نشود.
# توکن باید scoped باشد، نه Global API Key.
# مجوزهای لازم:
#   Account > Workers Scripts > Edit
#   Account > Workers KV Storage > Edit
#   Account > D1 > Edit
#   Account > Workers R2 Storage > Edit
#   Zone > DNS > Edit            (فقط اگر مدیریت DNS لازم است)
#   Zone > Workers Routes > Edit (فقط اگر مدیریت route لازم است)
# ============================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ============================================================
# Telegram (اختیاری) — اگر خالی باشد ربات غیرفعال می‌ماند.
# ============================================================
TELEGRAM_BOT_TOKEN=
# رشتهٔ تصادفی برای اعتبارسنجی webhook تلگرام
TELEGRAM_WEBHOOK_SECRET=
